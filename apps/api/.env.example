# PostgreSQL
DATABASE_URL="postgresql://fuse:fuse@localhost:5432/fuse_radio?schema=public"

# Auth
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="900s"
JWT_REFRESH_TTL="30d"

# Dispositivos (players) autenticam heartbeats com esta chave por tenant/loja
DEVICE_API_KEY="change-me-device-key"

# Servidor
PORT=4000
CORS_ORIGINS="http://localhost:3000"
