# URL da API Fuse Radio Enterprise.
# Sem esta variável, o player não envia heartbeats e o dashboard
# opera em modo demonstração (frota simulada, sem login).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Chave usada pelos players para autenticar heartbeats (mesmo valor
# de DEVICE_API_KEY na API).
NEXT_PUBLIC_DEVICE_KEY=change-me-device-key
